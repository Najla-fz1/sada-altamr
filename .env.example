# App
APP_NAME=Sada Al-Tamr
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Database - Local SQLite
SQLITE_DB_PATH=./local.db

# Database - PostgreSQL
POSTGRES_USER=sada_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sada_altamr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sada_user:change_me@postgres:5432/sada_altamr

# AI APIs
ALLAM_API_KEY=your_allam_api_key_here
ALLAM_API_URL=your_allam_api_url_here

CLAUDE_API_KEY=your_claude_api_key_here

# Whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=ar

# Security
JWT_SECRET_KEY=change_this_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
